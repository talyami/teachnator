# ========================================================
# إعدادات بيئة العمل للمولد الذكي للاختبارات (VPS & Local)
# ========================================================

# منفذ الخادم
PORT=3000
NODE_ENV=development

# --------------------------------------------------------
# 1. إعدادات قاعدة بيانات MySQL على السيرفر (VPS)
# --------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_vps_mysql_password
DB_NAME=fast_learning_db
DB_PORT=3306

# --------------------------------------------------------
# 2. مفاتيح الأمان والتشفير (Session & Key Encryption)
# --------------------------------------------------------
SESSION_SECRET=fast_learning_super_secret_session_key_32_chars_long_2026
KEY_ENCRYPTION_SECRET=fast_learning_aes256_encryption_secret_key_2026
JWT_SECRET=fast_learning_super_secret_jwt_key_2026_change_me

# --------------------------------------------------------
# 3. البريد الإلكتروني للمشرف (Admin Emails)
# أي حساب يسجل دخول بهذا البريد يحصل تلقائياً على رتبة مدير مع كامل الصلاحيات
# --------------------------------------------------------
ADMIN_EMAILS=talyami@gmail.com,admin@villa.linkflow.page

# --------------------------------------------------------
# 4. Server-only AI bootstrap (never sent to the browser)
# These values seed missing admin_settings rows at startup only.
# Change the database rows directly after initialization; env does not override them.
# Runtime AI requests require a connected MySQL database.
# --------------------------------------------------------
# Brain: OpenAI-compatible OmniRoute chat/completions
SERVER_BRAIN_URL=https://srv875806.tail759794.ts.net:10000/v1
SERVER_BRAIN_API_KEY=
SERVER_BRAIN_MODEL=combo-gemini-flash

# TTS: configured provider first, other configured provider as fallback
SERVER_TTS_PROVIDER=gemini
SERVER_TTS_MODEL=gemini-2.5-flash-preview-tts
SERVER_TTS_VOICE=Aoede
SERVER_GEMINI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_REGION=global
VERTEX_KEY_TOKEN=

# --------------------------------------------------------
# 5. معرّفات تسجيل الدخول (Google & Apple Client IDs)
# --------------------------------------------------------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# تفعيل تسجيل الدخول السريع التجريبي (مفيد جداً للاختبار المباشر)
ALLOW_DEV_LOGIN=true
