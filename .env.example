# Copy to .env outside the public web root. Never commit real credentials.
PORT=3025
NODE_ENV=production
HOST=127.0.0.1
TRUST_PROXY=loopback
JWT_ISSUER=fast-learning
JWT_AUDIENCE=fast-learning-web
AI_UPSTREAM_TIMEOUT_MS=180000
# Request circuit breakers, not monetary budgets; lower after measuring actual costs.
AI_GLOBAL_DAILY_GENERATION_LIMIT=200
AI_GLOBAL_DAILY_TTS_LIMIT=2000
AI_GLOBAL_DAILY_EVALUATE_LIMIT=2000
CORS_ORIGINS=https://your-domain.example
# Production proxy must strip untrusted forwarding headers. See config/nginx-fast-learning.conf.
# Run reviewed migrations during deployment; false makes startup verify all are applied.
DB_AUTO_MIGRATE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fast_learning_app
DB_PASSWORD=replace_with_a_unique_database_password
DB_NAME=fast_learning_db

# Generate a cryptographically random secret (32+ bytes); rotate with session invalidation.
JWT_SECRET=replace_with_a_cryptographically_random_secret_at_least_32_bytes
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# AI secrets are server-only. Existing admin_settings rows are NOT overwritten by env edits.
SERVER_BRAIN_URL=
SERVER_BRAIN_API_KEY=
SERVER_BRAIN_MODEL=gemini-2.5-flash
SERVER_GEMINI_API_KEY=
SERVER_TTS_PROVIDER=gemini
SERVER_TTS_MODEL=gemini-2.5-flash-preview-tts
SERVER_TTS_VOICE=Aoede
VERTEX_PROJECT_ID=
VERTEX_REGION=global
VERTEX_KEY_TOKEN=
APP_VERSION=1.3.0
APP_BUILD_HASH=
APP_FORCE_RELOAD=0

# Payments stay OFF until provider verification, webhook validation and real catalog setup.
# No active packs or prices are configured by this template.
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
CREDIT_PACKS_JSON=[]
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Public legal/support facts only: these values are intentionally published.
# Blank/invalid facts appear as unconfigured. Do not enter credentials or private links.
SUPPORT_EMAIL=
# International digits (optional leading +), 8-15 digits. Publishes a wa.me link.
SUPPORT_WHATSAPP=
# HTTPS without credentials, query or fragment.
PUBLIC_SUPPORT_URL=
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_COUNTRY=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_REGISTRATION=
# Owner review flag only, NOT certification/compliance. Date: YYYY-MM-DD.
LEGAL_POLICY_REVIEWED=false
LEGAL_REVIEWED_AT=
LEGAL_POLICY_VERSION=
# Publish actual providers/intermediaries and regions after reviewing your deployment.
# These are public disclosures, NOT settings that select or verify a runtime provider.
LEGAL_IDENTITY_PROVIDER=
LEGAL_AI_PROVIDER=
LEGAL_SPEECH_PROVIDER=
LEGAL_HOSTING_PROVIDER=
LEGAL_FONT_PROVIDER=
LEGAL_MONITORING_PROVIDER=
LEGAL_PROCESSING_LOCATIONS=

# Reviewed retention. Maintenance must be scheduled privately to delete expired rows.
# Bounds: audio 1-30 days; usage 1-365; daily budgets 2-90 (never reset today's counter).
TTS_CACHE_RETENTION_DAYS=7
AI_USAGE_RETENTION_DAYS=90
AI_DAILY_BUDGET_RETENTION_DAYS=7
# Linux VPS only. Backups are sensitive and unencrypted: encrypt off-host copies.
BACKUP_DIR=/var/backups/fast-learning
# 1-90 days; prune only owned completed dumps, after a successful backup.
BACKUP_RETENTION_DAYS=7
MYSQLDUMP_BIN=mysqldump
# Read-only readiness URL. Deployment-only command; never run against an unknown target.
HEALTHCHECK_URL=http://127.0.0.1:3025/api/ready
# Optional generic HTTPS JSON POST receiver. Entire URL is a server-only secret.
# Redirects refused, no provider-specific adapter/account provisioning. Sentry unsupported.
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_TIMEOUT_MS=3000
MONITOR_ALERT_COOLDOWN_SECONDS=1800
MONITOR_MAX_LATENCY_MS=2000
MONITOR_MAX_BACKUP_AGE_HOURS=36
# Private POSIX state directory owned by the job identity; systemd template creates it.
MONITOR_STATE_PATH=/var/lib/fast-learning-monitor/state.json
# Optional filesystem path for statfs available-space check; blank disables this check.
MONITOR_DISK_PATH=
MONITOR_DISK_MIN_FREE_PERCENT=10
